# ── 0G Network ────────────────────────────────────────────────────────────────
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_CHAIN_ID=16602
ZG_INDEXER_URL=https://indexer-storage-turbo-testnet.0g.ai
ZG_KV_URL=https://indexer-storage-turbo-testnet.0g.ai

# 0G Compute: set to a running inference provider address to enable LLM market regime
ZG_INFERENCE_PROVIDER=

# 0G Compute: set to a TeeML provider address to enable on-chain ML-DSA attestation
ZG_MLDSA_VERIFY_PROVIDER=

# ── Deployed contracts (populated after running deploy:testnet) ────────────────
NEXT_PUBLIC_PQC_KEY_REGISTRY=
NEXT_PUBLIC_TEE_VERIFIER=
NEXT_PUBLIC_SKILL_REGISTRY=
NEXT_PUBLIC_AGENT_NFT=
NEXT_PUBLIC_AGENT_REGISTRY=

# ── Deployer wallet ────────────────────────────────────────────────────────────
# Either name works; DEPLOYER_PRIVATE_KEY takes precedence
DEPLOYER_PRIVATE_KEY=

# Optional: public URL of the deployed frontend. Deploy script calls
# AgentNFT.setBaseURI so block explorers fetch metadata via HTTP instead of
# a data: URI they can't resolve. Must not have a trailing slash.
# e.g. https://spike.vercel.app
APP_URL=
# PRIVATE_KEY=

# ── 0G Storage server-side signer ────────────────────────────────────────────
# Private key used by the Next.js API route (/api/storage/upload) to sign 0G
# Storage upload transactions. The browser can't run the Node.js SDK directly.
# Can be the same key as DEPLOYER_PRIVATE_KEY on testnet.
STORAGE_PRIVATE_KEY=

# Attestor address for TeeAttestationVerifier (defaults to deployer if unset)
ATTESTOR_ADDRESS=

# ── Services ──────────────────────────────────────────────────────────────────
QUANTUM_SERVICE_URL=http://localhost:8000
AGENT_PORT=3001
AGENT_STATE_FILE=./agents.json
AGENT_API_KEY=
AGENT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_AGENT_URL=http://localhost:3001
NEXT_PUBLIC_AGENT_API_KEY=
NEXT_PUBLIC_QUANTUM_URL=http://localhost:8000
NEXT_PUBLIC_ZG_NETWORK=testnet
NEXT_PUBLIC_WC_PROJECT_ID=

# ── Contract verification (optional — only needed for npx hardhat verify) ─────
ETHERSCAN_API_KEY=
